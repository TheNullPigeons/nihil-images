# Nihil colors: cyan info, yellow warnings, magenta credentials.
# GENERAL INFO
regexp=.*\[\*\].*
colours=bright_cyan
=======
# GENERAL WARNING
regexp=.*\[\!\].*
colours=bright_yellow
=======
# GENERAL DEFAULT
regexp=.*\[\-\].*
colours=default
=======
# DEBUG SUCCESS
regexp=.*\[\+\] Found.*
colours=bright_green
=======
# SUCCESS FOUND Files and directories
regexp=.*Found matching.*
colours=bold bright_green
=======
# SUCCESS FOUND Username
regexp=.*newName.*:.*
colours=bright_cyan
=======
# SUCCESS FOUND Username
regexp=.*userName.*:.*
colours=bright_cyan
=======
# SUCCESS FOUND runAs
regexp=.*runAs.*:.*
colours=bright_cyan
=======
# SUCCESS FOUND Password
regexp=.*password.*:.*
colours=bold bright_magenta
=======
