#!/bin/bash

BH_BIN="/opt/tools/BloodHound-Legacy/BloodHound"
export PATH="/opt/tools/bin:$PATH"
export NEO4J_HOME
NEO4J_HOME="$(grep -oP '(?<=exec ").*(?=/bin/neo4j)' /opt/tools/bin/neo4j 2>/dev/null | head -1)"
[ -d "$NEO4J_HOME" ] || NEO4J_HOME="$(ls -d /opt/neo4j-community-* 2>/dev/null | head -1)"

# Neo4j
if ! "$NEO4J_HOME/bin/neo4j" status 2>/dev/null | grep -q "is running"; then
    echo "[nihil] Starting Neo4j..."
    "$NEO4J_HOME/bin/neo4j" start >/dev/null 2>&1
    echo "[nihil] Waiting for Neo4j..."
    for i in $(seq 1 60); do
        "$NEO4J_HOME/bin/neo4j" status 2>/dev/null | grep -q "is running" && break || sleep 2
    done
fi
for i in $(seq 1 30); do
    ss -tlnp 2>/dev/null | grep -q ':7687' && break || sleep 2
done

echo "[nihil] Starting BloodHound (legacy)..."
echo "[nihil] Neo4j → bolt://localhost:7687 | Login: neo4j / fly2own1"
exec "$BH_BIN" --no-sandbox --disable-dev-shm-usage "$@"
