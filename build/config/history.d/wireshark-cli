tshark -r capture.pcap
tshark -r capture.pcap -Y "http"
tshark -r capture.pcap -Y "tcp.port == 80" -T fields -e http.request.uri
tshark -r capture.pcap -Y "dns" -T fields -e dns.qry.name
tshark -r capture.pcap -qz io,stat,1
tshark -r capture.pcap -Y "http" -T fields -e http.file_data | xxd -r -p
tshark -i "$INTERFACE" -w capture.pcap
tshark -F pcap -r capture.pcapng -w capture.pcap
tshark -r capture.pcap -Y "http.request"
tshark -r capture.pcap -T fields -e ip.src -e ip.dst | sort -u
tshark -r capture.pcap -Y 'http.request.method == "POST"' -T fields -e http.host -e http.request.uri
tshark -r capture.pcap -Y 'kerberos.CNameString' -T fields -e kerberos.CNameString | sort -u
tshark -r capture.pcap -Y 'ntlmssp' -V | grep -i 'NTLMSSP_NEGOTIATE\|NTLMSSP_CHALLENGE\|NTLMSSP_AUTH'
tshark -r capture.pcap -Y 'smb2' -T fields -e smb2.cmd -e smb2.filename | sort -u
wireshark
